{
    "name": "alexis-gss/memoria",
    "version": "5.5.4",
    "description": "Gallery of pictures from a lot of games, realised under Laravel.",
    "homepage": "https://memoria.alexis-gousseau.com",
    "authors": [
        {
            "name": "Alexis Gousseau",
            "homepage": "https://alexis-gousseau.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "alexis-gss",
        "laravel",
        "games",
        "images"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "erusev/parsedown": "^1.7",
        "guzzlehttp/guzzle": "^7.2",
        "james-heinrich/getid3": "^1.9",
        "laravel/framework": "^13.0",
        "laravel/telescope": "^5.20",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6.3",
        "pion/laravel-chunk-upload": "^1.6",
        "sentry/sentry-laravel": "^4.22",
        "spatie/laravel-sitemap": "^7.4",
        "spatie/laravel-translatable": "^6.13",
        "spatie/schema-org": "^3.23"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "slevomat/coding-standard": "^8.10",
        "spatie/laravel-ignition": "^2.9",
        "larastan/larastan": "^3.9",
        "squizlabs/php_codesniffer": "^3.7",
        "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/pest --coverage --min=85 --parallel"
        ],
        "test:coverage": [
            "vendor/bin/pest --coverage --coverage-html coverage-report --min=85 --parallel"
        ],
        "lint": [
            "vendor/bin/phpcs --standard=phpcs.xml --extensions=php --ignore=vendor/*,storage/*,bootstrap/*,node_modules/*",
            "vendor/bin/phpstan analyse --memory-limit=1G",
            "vendor/bin/pint --test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laravel-shift/colour.git"
        }
    ]
}
