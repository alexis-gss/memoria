{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "types": [
            "node",
            "vite/client"
        ],
        "paths": {
            "~/*": [
                "./node_modules/*",
                "./node_modules/@types/*"
            ],
            "@/*": [
                "./resources/assets/*"
            ]
        }
    },
    "include": [
        "resources/**/*.ts",
        "resources/**/*.vue",
        "vite.config.ts"
    ],
    "exclude": ["node_modules"]
}
